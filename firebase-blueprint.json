{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access information",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 20 },
        "role": { "type": "string", "enum": ["buyer", "seller", "admin", "superadmin"] },
        "avatar": { "type": "string", "maxLength": 500 },
        "city": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["active", "suspended", "blocked"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Vehicle listing with approval state and detailed specs",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "sellerId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "categoryId": { "type": "string", "maxLength": 50 },
        "categoryName": { "type": "string", "maxLength": 50 },
        "brandId": { "type": "string", "maxLength": 50 },
        "brandName": { "type": "string", "maxLength": 50 },
        "model": { "type": "string", "maxLength": 100 },
        "variant": { "type": "string", "maxLength": 100 },
        "year": { "type": "number" },
        "price": { "type": "number" },
        "negotiable": { "type": "boolean" },
        "fuelType": { "type": "string", "enum": ["Petrol", "Diesel", "Electric", "Hybrid", "CNG", "LPG"] },
        "transmission": { "type": "string", "enum": ["Manual", "Automatic", "Semi-Automatic"] },
        "kmDriven": { "type": "number" },
        "color": { "type": "string", "maxLength": 50 },
        "engine": { "type": "string", "maxLength": 100 },
        "ownership": { "type": "string", "enum": ["First Owner", "Second Owner", "Third Owner", "4+ Owners"] },
        "registrationNumber": { "type": "string", "maxLength": 30 },
        "insurance": { "type": "string", "maxLength": 50 },
        "condition": { "type": "string", "enum": ["Brand New", "Like New", "Excellent", "Good", "Fair"] },
        "description": { "type": "string", "maxLength": 3000 },
        "images": { "type": "array" },
        "featuredImage": { "type": "string", "maxLength": 500 },
        "location": { "type": "object" },
        "sellerInfo": { "type": "object" },
        "status": { "type": "string", "enum": ["draft", "pending", "approved", "rejected", "published", "sold", "expired", "archived"] },
        "rejectionReason": { "type": "string", "maxLength": 500 },
        "featured": { "type": "boolean" },
        "views": { "type": "number" },
        "interestCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "approvedAt": { "type": "string" },
        "approvedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "sellerId", "title", "categoryId", "brandId", "price", "status"]
    },
    "Interest": {
      "title": "Interest",
      "description": "Buyer inquiry on a specific vehicle",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "vehicleId": { "type": "string", "maxLength": 128 },
        "vehicleTitle": { "type": "string", "maxLength": 150 },
        "vehicleImage": { "type": "string", "maxLength": 500 },
        "vehiclePrice": { "type": "number" },
        "sellerId": { "type": "string", "maxLength": 128 },
        "buyerId": { "type": "string", "maxLength": 128 },
        "buyerName": { "type": "string", "maxLength": 100 },
        "buyerPhone": { "type": "string", "maxLength": 20 },
        "buyerEmail": { "type": "string", "maxLength": 150 },
        "buyerLocation": { "type": "string", "maxLength": 100 },
        "preferredContact": { "type": "string", "enum": ["Phone Call", "WhatsApp", "Email"] },
        "message": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["New", "Contacted", "Interested", "Negotiating", "Closed", "Not Interested"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "vehicleId", "sellerId", "buyerName", "buyerPhone", "status"]
    },
    "Message": {
      "title": "Message",
      "description": "Direct chat message between buyer and seller",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "receiverId": { "type": "string", "maxLength": 128 },
        "vehicleId": { "type": "string", "maxLength": 128 },
        "text": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "conversationId", "senderId", "receiverId", "text"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Registered user accounts with roles"
    },
    "/vehicles/{vehicleId}": {
      "schema": "Vehicle",
      "description": "Marketplace vehicle listings"
    },
    "/interests/{interestId}": {
      "schema": "Interest",
      "description": "Buyer inquiries and leads"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "In-app direct messages"
    }
  }
}
